{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "icons": "node scripts/make-icons.mjs",
        "email-assets": "python3 scripts/make-email-logo.py",
        "test:e2e": "playwright test --config=tests/e2e/playwright.config.mjs",
        "test:a11y": "playwright test --config=tests/e2e/playwright.config.mjs --grep 'axe|Lighthouse'",
        "test:selection": "node --test tests/selection-system.test.mjs",
        "test:auth-intro": "node --test tests/auth-intro.test.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.0.0",
        "axe-core": "^4.14.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "lighthouse": "^13.6.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@inertiajs/vue3": "^3.11.0",
        "@tiptap/extension-highlight": "^3.35.0",
        "@tiptap/extension-image": "^3.35.0",
        "@tiptap/extension-placeholder": "^3.35.0",
        "@tiptap/extension-subscript": "^3.35.0",
        "@tiptap/extension-superscript": "^3.35.0",
        "@tiptap/extension-text-align": "^3.35.0",
        "@tiptap/starter-kit": "^3.35.0",
        "@tiptap/vue-3": "^3.35.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "vue": "^3.5.46"
    }
}
